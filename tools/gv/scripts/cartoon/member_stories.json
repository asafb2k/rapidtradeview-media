                    "reader": "rx", "rx": "Buys\\n(?P<buys>\\d+)\\nSells\\n(?P<sells>\\d+)\\nTickers\\n(?P<tickers>\\d+)"},
        "names": {"url": "https://www.rapidtradeview.trade/stocks/I", "target": "Intel Corporation"}
