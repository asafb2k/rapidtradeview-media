   "banner_chip": "[data-testid=\"pattern-banner-chip\"]",
   "not_a_prediction": "[data-testid=\"pattern-banner-sub\"]",
   "show_chip": "[data-testid=\"pattern-chip\"]",
   "chart": "up:1:[data-testid=\"pattern-banner\"]",
   "chart_hidden": "up:1:[data-testid=\"pattern-chip\"]",
   "card": "closest:.rounded-2xl|[data-testid=\"pattern-banner\"]",
   "card_hidden": "closest:.rounded-2xl|[data-testid=\"pattern-chip\"]",
   "header": "header",
   "ticker_logo": "js:[...document.querySelectorAll('img')].find(i => { const b = i.getBoundingClientRect(); return b.top >= 0 && b.bottom <= 100 && b.width > 20 && b.width < 90; })",
   "sma": "js:[...document.querySelectorAll('label')].find(l => l.innerText.trim() === 'SMA')"
  },
  "keepout_rx": [
   "^HOLD$",
   "^BUY$",
   "^SELL$",
   "bullish",
   "bearish",
   "/100",
   "^\\d/\\d$",
   "our record",
   "key level",
   "reddit",
   "vader",
   "elbstream",
   "yahoo",
   "finnhub",
   "stocktwits",
   "apewisdom",
   "google news",
   "operated by",
   "sponsored",
   "price target",
   "\\([DRI]-[A-Z]{2}\\)",
   "^[DRI] · "
  ],
  "keepout_block": {
   "indicators row": [
    "Indicators",
    2
   ],
   "chart pattern card": [
    "Chart pattern",
    2
   ]
  },
  "keepout_sel": {
   "bottom tab bar": "nav[class*=\"fixed\"], div[class*=\"fixed\"][class*=\"bottom-0\"]"
  },
  "actions": [
   {
    "do": "wait_for",
    "sel": "[data-testid=\"pattern-banner\"]",
    "then_ms": 1200
   },
   {
    "do": "settle_network",
    "timeout": 12000
   },
   {
    "do": "wait",
    "s": 1.0
   },
   {
    "do": "snap",
    "label": "top"
   },
   {
    "do": "jump_to",
    "sel": "[data-testid=\"pattern-banner\"]",
    "up": ".rounded-2xl",
    "gap": 8
   },
   {
    "do": "wait_until",
    "since": "jumped",
    "s": "1.9"
   },
   {
    "do": "tap",
    "name": "setup_hide",
    "sel": "[data-testid=\"pattern-banner\"] button",
    "setup": true
   },
   {
    "do": "wait_until",
    "since": "setup_hide",
    "s": "0.7"
   },
   {
    "do": "tap",
    "name": "sma_off",
    "sel": "label:has-text(\"SMA\")",
    "setup": true
   },
   {
    "do": "wait_until",
    "since": "sma_off",
    "s": "0.5"
   },
   {
    "do": "check",
    "js": "() => { const l = [...document.querySelectorAll('label')].find(x => x.innerText.trim() === 'SMA'); return l ? !l.querySelector('input').checked : null; }",
    "expect": true,
    "what": "SMA unchecked"
   },
   {
    "do": "snap",
    "label": "setup_hidden"
   },
   {
    "do": "wait_until",
    "since": "sma_off",
    "s": "1.2"
   },
   {
    "do": "tap",
    "name": "show1",
