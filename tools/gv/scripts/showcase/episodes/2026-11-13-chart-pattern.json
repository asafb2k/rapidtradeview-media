{
 "slug": "2026-11-13-chart-pattern",
 "series": "SHOWCASE: one RapidTradeView feature a day, its real screen in a phone",
 "day": 1,
 "feature": "chart pattern drawn on the chart (draw-on, Hide, Show)",
 "one_sentence": "RapidTradeView draws the chart pattern on the chart for you.",
 "take": {
  "rects": {
   "banner": "[data-testid=\"pattern-banner\"]",
