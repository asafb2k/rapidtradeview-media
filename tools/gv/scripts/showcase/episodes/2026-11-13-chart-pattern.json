    "s": "1.45"
   },
   {
    "do": "snap",
    "label": "drawn"
   },
   {
    "do": "wait_until",
    "since": "show1",
    "s": "{src_hide_after_show1}"
   },
   {
    "do": "tap",
    "name": "hide",
    "sel": "[data-testid=\"pattern-banner\"] button"
   },
   {
    "do": "wait_until",
    "since": "hide",
    "s": "0.3"
   },
   {
    "do": "snap",
    "label": "hidden"
   },
   {
    "do": "wait_until",
    "since": "hide",
    "s": "{t_show} - {t_hide}"
   },
   {
    "do": "tap",
    "name": "show",
    "sel": "[data-testid=\"pattern-chip\"]"
   },
   {
    "do": "wait_until",
    "since": "show",
    "s": "1.3"
   },
   {
    "do": "snap",
    "label": "shown"
   },
   {
    "do": "wait_until",
    "since": "show",
    "s": "{src_hide_b_after_show}"
   },
   {
    "do": "tap",
    "name": "hide_b",
    "sel": "[data-testid=\"pattern-banner\"] button"
   },
   {
    "do": "wait_until",
    "since": "hide_b",
    "s": "{t_show_b} - {t_hide_b}"
   },
   {
    "do": "tap",
    "name": "show_b",
    "sel": "[data-testid=\"pattern-chip\"]"
   },
   {
    "do": "wait_until",
    "since": "show_b",
    "s": "1.4"
   },
   {
    "do": "snap",
    "label": "shown_b"
   },
   {
    "do": "wait_until",
    "since": "show_b",
    "s": "{t_hide_end} - {t_show_b}"
   },
   {
    "do": "tap",
    "name": "hide_end",
    "sel": "[data-testid=\"pattern-banner\"] button"
   },
   {
    "do": "wait_until",
    "since": "hide_end",
    "s": "{t_show_end} - {t_hide_end}"
   },
   {
    "do": "tap",
    "name": "show_end",
    "sel": "[data-testid=\"pattern-chip\"]"
   },
   {
    "do": "wait_until",
    "since": "show_end",
    "s": "1.6"
   },
   {
    "do": "snap",
    "label": "end_shown"
   }
  ],
  "taps_used": {
   "hook": "show1",
   "hide": "hide",
   "show": "show",
   "hide_b": "hide_b",
   "show_b": "show_b",
