+/** The real post as an image story from the switch day (2026-10-11): its own Reel for Instagram, the images for the rest. */
+function reelsOnlyManifest(date = "2026-10-12"): Loose {
+    const m = imageManifest(date);
+    const p = m.posts[0];
+    p.media = { reel_9x16: videoMediaUrl(date, p.story_id, "reel_9x16") };
+    Object.assign(p.platforms.instagram, { placement: "reel", media_type: "video", media: "reel_9x16", media_url: p.media.reel_9x16, caption: "c Not investment advice.", link_sticker_url: null });
+    return m;
+}
+
 function errorsOf(m: unknown, date = DATE): string[] {
     const r = validateVideoManifest(m, date);
     return r.ok ? [] : r.errors;
 }
+
